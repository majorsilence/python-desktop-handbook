#!@PYTHON@
# Generated by Meson from example-app.in. Do not edit the installed copy.

import gettext
import locale
import os
import sys

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)

import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gio

resource = Gio.Resource.load(os.path.join(pkgdatadir, 'example-app.gresource'))
resource._register()

# The domain has to be bound twice: once for Python's gettext, and once through
# the C library, which is what GtkBuilder uses to translate the strings inside
# the .ui files. Binding only the first leaves the interface untranslated.
locale.setlocale(locale.LC_ALL, '')
gettext.bindtextdomain('example-app', localedir)
gettext.textdomain('example-app')
try:
    locale.bindtextdomain('example-app', localedir)
    locale.textdomain('example-app')
except AttributeError:
    pass          # not available on Windows; see the translation chapter

from exampleapp import application
sys.exit(application.main(VERSION))
